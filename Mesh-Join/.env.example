# Copy to .env and replace the placeholders. .env is ignored by git; never commit it.
# Only docker compose and the test suite read these. The program itself always asks
# for its password at startup.

# Root password for the throwaway server in docker-compose.yml.
MYSQL_ROOT_PASSWORD=change-me

# Server used by the integration tests. They are skipped when these are not set.
DWH_TEST_HOST=127.0.0.1
DWH_TEST_PORT=3307
DWH_TEST_USER=root
DWH_TEST_PASSWORD=change-me
